@article{Bercos-Hickey_2022,
  Author =	 {Bercos-Hickey, Emily and O'Brien, Travis A. and
                  Wehner, Michael F. and Zhang, Likun and Patricola,
                  Christina M. and Huang, Huanping and Risser, Mark
                  D.},
  Title =	 {{Anthropogenic Contributions to the 2021 Pacific
                  Northwest Heatwave}},
  Journal =	 {Geophysical Research Letters},
  Year =	 2022,
  Volume =	 49,
  Number =	 23,
  oMonth =	 {Dec 16},
  Abstract =	 {Daily maximum temperatures during the 2021 heatwave
                  in the Pacific Northwest United States and Canada
                  shattered century old records.  Multiple causal
                  factors, including anthropogenic climate change,
                  contributed to these high temperatures, challenging
                  traditional methods of attributing human
                  influence. We demonstrate that the observed 2021
                  daily maximum temperatures are far above the bounds
                  of Generalized Extreme Value distributions fitted
                  from historical data. Hence, confidence in Granger
                  causal inference statements about the human
                  influence on this heatwave is low. Alternatively, we
                  present a more conditional hindcast attribution
                  study using two regional models. We performed
                  ensembles of simulations of the heatwave to
                  investigate how the event would have changed if it
                  had occurred without anthropogenic climate change
                  and with future warming. We found that global
                  warming caused a similar to 0.8 degrees C-1 degrees
                  C increase in heatwave temperatures. Future warming
                  would lead to a similar to 5 degrees C increase in
                  heatwave temperature by the end of the 21st century.
                  Plain Language Summary While it is clear that global
                  warming causes heatwaves to be warmer, the unique
                  meteorological conditions behind the 2021 Pacific
                  Northwest heatwave tax our ability to make
                  quantitative estimates of the human contribution. We
                  discuss why there is low confidence in traditional
                  estimates of the human contribution to this
                  heatwave's temperatures and present an alternative,
                  albeit more highly constrained estimate that human
                  activities caused a similar to 0.8 degrees C-1
                  degrees C increase in the observed daily maximum
                  temperatures. Additional future warming would lead
                  to a similar to 5 degrees C increase in the heatwave
                  by the end of the 21st century.},
  Doi =		 {10.1029/2022Gl099396},
  Article-Number ={e2022Gl099396},
  Issn =	 {0094-8276},
  EISSN =	 {1944-8007},
  ResearcherID-Numbers ={Wehner, Michael/F-7841-2015 Huang,
                  Huanping/Z-6027-2019 Bercos-Hickey,
                  Emily/S-6121-2019 Patricola, Christina/L-9902-2016
                  Risser, Mark/J-5801-2015 O'Brien, Travis/M-5250-2013
                  Zhang, Likun/AAZ-3238-2020},
  ORCID-Numbers ={Wehner, Michael/0000-0001-5991-0082 Huang,
                  Huanping/0000-0002-6153-6357 Patricola,
                  Christina/0000-0002-3387-0307 Zhang,
                  Likun/0000-0001-5458-4556 Risser,
                  Mark/0000-0003-1956-1783 O'Brien,
                  Travis/0000-0002-6643-1175 },
