  author =	 {Christopher C. Bernido and M. Victoria
                  Carpio-Bernido and Matthew G.O. Escobido},
  keywords =	 {Exponentially modified Brownian motion, Cyclone
                  track fluctuations, Fluctuations with memory},
  abstract =	 {Fluctuations in a time series for tropical cyclone
                  tracks are investigated based on an exponentially
                  modified Brownian motion. The mean square
                  displacement (MSD) is evaluated and compared to a
                  recent work on cyclone tracks based on fractional
                  Brownian motion (fBm). Unlike the work based on fBm,
                  the present approach is found to capture the
                  behavior of MSD versus time graphs for cyclones even
                  for large values of time.}
}

